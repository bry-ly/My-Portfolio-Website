# GitHub
# Used by the live activity endpoint (/api/activity) to fetch public events.
# Optional, but recommended to increase API rate limits.
GITHUB_TOKEN=

# Optional override for the username used by /api/activity.
GITHUB_USERNAME=

# Resend (required for contact form emails)
RESEND_API_KEY=

# Email routing
EMAIL_RECIPIENT=

# Optional sender identity
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=
